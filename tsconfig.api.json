{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2023", "lib": ["ES2023", "DOM"], "module": "nodenext",
    "moduleResolution": "nodenext", "allowImportingTsExtensions": true,
    "noEmit": true, "strict": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["api", "server"]
}
