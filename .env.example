# Leave disabled until the database, Google OAuth web client, and staff allowlist are configured.
VITE_SHARED_ORDERS=false
WORKSPACE_STORAGE=sheets
WORKSPACE_SHEETS_ENDPOINT=
WORKSPACE_SHEETS_SECRET=
# Server-only settings. Never use VITE_ prefixes for secrets or connection strings.
GOOGLE_CLIENT_ID=
DATABASE_URL=
WORKSPACE_ORIGIN=https://cjeng.vercel.app
WORKSPACE_ALLOWED_EMAILS=
WORKSPACE_SESSION_SECRET=
# Barobill card approvals (server only, never expose via VITE_ variables).
BAROBILL_CERT_KEY=
BAROBILL_CORP_NUM=
BAROBILL_USER_ID=
# Optional: test uses testws.baroservice.com; production is the default.
BAROBILL_ENV=production
